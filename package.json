{
  "name": "kull-aegisub-renderer",
  "productName": "Kull Aegisub Renderer",
  "version": "2.1.0",
  "description": "Desktop app that hardsubs ASS/SRT subtitles into video (Vietsub) with FFmpeg + VSFilter — Tauri + Rust + React + TailwindCSS",
  "author": "Kull Aegisub",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 tauri dev\"",
    "build": "vite build",
    "start": "npm run build && tauri start",
    "tauri": "tauri",
    "check:bin": "node scripts/checkBin.js",
    "test:i18n": "node scripts/checkI18n.js",
    "test:arrow-step": "node scripts/test-arrow-step.js",
    "test:frame-step": "node scripts/test-frame-step.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.445.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
