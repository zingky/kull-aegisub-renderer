{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kull Aegisub Renderer",
  "version": "2.1.0",
  "identifier": "com.kull.aegisubrenderer",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kull Aegisub Renderer",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
